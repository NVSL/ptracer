##############################################################

###### Finalize sanity here ######

# This section contains recipes for tests other than the default.
# See makefile.default.rules for the default test rules.
# All tests in this section should adhere to the naming convention: <testname>.test

# Tests one aspect of PIN_SpawnApplicationThread() which is that it can exit gracefully
# The verbose tool output includes the spawned native tid; verify it also appears in a thread start callback.
spawn_app_thread.test: $(OBJDIR)spawn_app_thread_tool$(PINTOOL_SUFFIX) $(OBJDIR)spawn_app_thread_app$(EXE_SUFFIX)
	$(PIN) -t $(OBJDIR)spawn_app_thread_tool$(PINTOOL_SUFFIX) -v -- $(OBJDIR)spawn_app_thread_app$(EXE_SUFFIX) > $(OBJDIR)spawn_app_thread.out 2>&1
	$(BASHTEST) -n "`$(AWK) -F'[()]' '/Spawned a new thread/ { print $$2; exit }' $(OBJDIR)spawn_app_thread.out`"
	$(QGREP) "Native TID: `$(AWK) -F'[()]' '/Spawned a new thread/ { print $$2; exit }' $(OBJDIR)spawn_app_thread.out`" $(OBJDIR)spawn_app_thread.out 2>&1
	$(RM) $(OBJDIR)spawn_app_thread.out

# Test that Pin is able to run application that creates detached thread (basic test)
pthread_create_detached.test: $(OBJDIR)pthread_create_detached_app$(EXE_SUFFIX)
	$(PIN) -- $(OBJDIR)pthread_create_detached_app$(EXE_SUFFIX) > $(OBJDIR)pthread_create_detached.out 2>&1
	$(QGREP) "Detached Thread is finishing" $(OBJDIR)pthread_create_detached.out 2>&1
	$(QGREP) "Main thread is finishing" $(OBJDIR)pthread_create_detached.out 2>&1
	$(RM) $(OBJDIR)pthread_create_detached.out

